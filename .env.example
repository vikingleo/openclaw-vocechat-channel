# ============================================================
# VoceChat Channel Plugin 环境变量配置示例
# ============================================================
#
# 使用说明：
# 1. 复制本文件为 .env 并填写实际值
# 2. 环境变量优先级：环境变量 > JSON配置 > 代码默认值
# 3. 支持按群组单独配置，格式：VOCECHAT_GROUP_{群组ID}_配置项
# 4. 布尔值：true/false、1/0、yes/no 都支持
# 5. 列表值：用逗号分隔，如 "小助手,AI,机器人"
#
# 重要：群聊回复门禁优先级
# ┌─────────────────────────────────────────────────┐
# │ 第一层：OpenClaw 主程序原生配置（首要门禁）    │
# │   - requireMention（必须原生@）                 │
# │   - groupPolicy（群组策略）                      │
# │   - groupAllowFrom（发送者白名单）              │
# │         ↓ 通过后                                │
# │ 第二层：插件触发器配置（细化控制）             │
# │   - nativeMention（原生@触发）                  │
# │   - textMention（文本匹配触发）                 │
# │   - questionAuto（问句自动触发）                │
# │   - replyToBot（回复触发）                      │
# └─────────────────────────────────────────────────┘
#
# 注意：
# - 如果 OpenClaw 主程序设置了 requireMention=true，
#   则必须原生 @ 机器人才能触发，插件的其他触发器会被忽略
# - 只有主程序允许的情况下，才会评估插件触发器配置
#

# ------------------------------------------------------------
# 队列控制配置
# ------------------------------------------------------------

# 队列控制访问令牌（可选，用于远程队列管理接口鉴权）
# 如果不设置，队列控制接口将不需要鉴权
# VOCECHAT_QUEUE_CONTROL_TOKEN=your_secret_token_here

# 队列单个任务超时时间（毫秒）
# 默认：600000（10分钟）
# 范围：10000 ~ 3600000（10秒 ~ 1小时）
# VOCECHAT_QUEUE_ITEM_TIMEOUT_MS=600000


# ------------------------------------------------------------
# 群聊触发器配置 - 默认配置（适用于所有未单独配置的群）
# ------------------------------------------------------------

# 是否启用原生 @ 机器人触发
# 默认：true
# 说明：当用户在群聊中 @机器人 时触发回复
VOCECHAT_GROUP_DEFAULT_NATIVE_MENTION=true

# 是否启用文本名称匹配触发
# 默认：true
# 说明：当消息中包含机器人名称、昵称时触发回复
VOCECHAT_GROUP_DEFAULT_TEXT_MENTION=true

# 是否启用问句自动触发
# 默认：true
# 说明：自动识别疑问句（包含？、吗、呢等）并触发回复
VOCECHAT_GROUP_DEFAULT_QUESTION_AUTO=false

# 是否启用回复机器人消息触发（实验性功能）
# 默认：false
# 说明：当用户回复/引用机器人的消息时触发回复
# 注意：需要 VoceChat webhook 支持 reply_to 字段
VOCECHAT_GROUP_DEFAULT_REPLY_TO_BOT=false

# 自定义文本匹配模式（逗号分隔）
# 说明：这些关键词出现在消息中时会触发回复
# 示例：小助手,AI,机器人,克劳,客服,助理
VOCECHAT_GROUP_DEFAULT_MENTION_PATTERNS=

# 匹配模式模式
# 可选值：append（追加到系统默认） | replace（替换系统默认）
# 默认：append
# 说明：
#   - append: 自定义模式会追加到系统自动识别的 agent name 之后
#   - replace: 自定义模式会完全替换系统默认，只使用你配置的模式
VOCECHAT_GROUP_DEFAULT_MENTION_PATTERNS_MODE=append


# ------------------------------------------------------------
# 群聊触发器配置 - 特定群组配置示例
# ------------------------------------------------------------
# 格式：VOCECHAT_GROUP_{群组ID}_{配置项}
# 说明：特定群组的配置会覆盖默认配置
#

# 示例：群组 12345 的配置
# 只启用 @ 触发，关闭其他所有触发器
# VOCECHAT_GROUP_12345_NATIVE_MENTION=true
# VOCECHAT_GROUP_12345_TEXT_MENTION=false
# VOCECHAT_GROUP_12345_QUESTION_AUTO=false
# VOCECHAT_GROUP_12345_REPLY_TO_BOT=false

# 示例：群组 67890 的配置
# 启用所有触发器 + 自定义匹配模式
# VOCECHAT_GROUP_67890_NATIVE_MENTION=true
# VOCECHAT_GROUP_67890_TEXT_MENTION=true
# VOCECHAT_GROUP_67890_QUESTION_AUTO=true
# VOCECHAT_GROUP_67890_REPLY_TO_BOT=true
# VOCECHAT_GROUP_67890_MENTION_PATTERNS=小助手,AI助理,智能客服
# VOCECHAT_GROUP_67890_MENTION_PATTERNS_MODE=replace

# 示例：群组 999 的配置
# 只响应明确 @ 和回复，不自动介入讨论
# VOCECHAT_GROUP_999_NATIVE_MENTION=true
# VOCECHAT_GROUP_999_TEXT_MENTION=false
# VOCECHAT_GROUP_999_QUESTION_AUTO=false
# VOCECHAT_GROUP_999_REPLY_TO_BOT=true


# ------------------------------------------------------------
# 全局触发器配置（简化版，适用于所有群组）
# ------------------------------------------------------------
# 注意：如果同时设置了 VOCECHAT_GROUP_DEFAULT_* 和 VOCECHAT_TRIGGER_*，
#       优先使用 VOCECHAT_GROUP_DEFAULT_* 配置
#

# 全局启用 @ 触发
# VOCECHAT_TRIGGER_NATIVE_MENTION=true

# 全局启用文本匹配触发
# VOCECHAT_TRIGGER_TEXT_MENTION=true

# 全局启用问句自动触发
# VOCECHAT_TRIGGER_QUESTION_AUTO=false

# 全局启用回复触发
# VOCECHAT_TRIGGER_REPLY_TO_BOT=false

# 全局文本匹配模式
# VOCECHAT_MENTION_PATTERNS=小助手,AI,机器人


# ------------------------------------------------------------
# 配置示例场景
# ------------------------------------------------------------

# 场景 1: 严格模式（只响应明确 @）
# VOCECHAT_GROUP_DEFAULT_NATIVE_MENTION=true
# VOCECHAT_GROUP_DEFAULT_TEXT_MENTION=false
# VOCECHAT_GROUP_DEFAULT_QUESTION_AUTO=false
# VOCECHAT_GROUP_DEFAULT_REPLY_TO_BOT=false

# 场景 2: 主动模式（响应所有疑问）
# VOCECHAT_GROUP_DEFAULT_NATIVE_MENTION=true
# VOCECHAT_GROUP_DEFAULT_TEXT_MENTION=true
# VOCECHAT_GROUP_DEFAULT_QUESTION_AUTO=true
# VOCECHAT_GROUP_DEFAULT_REPLY_TO_BOT=true

# 场景 3: 客服模式（多种触发方式 + 自定义关键词）
# VOCECHAT_GROUP_DEFAULT_NATIVE_MENTION=true
# VOCECHAT_GROUP_DEFAULT_TEXT_MENTION=true
# VOCECHAT_GROUP_DEFAULT_QUESTION_AUTO=false
# VOCECHAT_GROUP_DEFAULT_REPLY_TO_BOT=true
# VOCECHAT_GROUP_DEFAULT_MENTION_PATTERNS=客服,帮助,咨询,报修,问题
# VOCECHAT_GROUP_DEFAULT_MENTION_PATTERNS_MODE=append

# 场景 4: 混合模式（不同群组不同策略）
# 默认：只响应 @
# VOCECHAT_GROUP_DEFAULT_NATIVE_MENTION=true
# VOCECHAT_GROUP_DEFAULT_TEXT_MENTION=false
# VOCECHAT_GROUP_DEFAULT_QUESTION_AUTO=false
#
# 客服群：全面响应
# VOCECHAT_GROUP_12345_NATIVE_MENTION=true
# VOCECHAT_GROUP_12345_TEXT_MENTION=true
# VOCECHAT_GROUP_12345_QUESTION_AUTO=true
# VOCECHAT_GROUP_12345_MENTION_PATTERNS=客服,帮助
#
# 技术群：只响应 @ 和专业关键词
# VOCECHAT_GROUP_67890_NATIVE_MENTION=true
# VOCECHAT_GROUP_67890_TEXT_MENTION=true
# VOCECHAT_GROUP_67890_QUESTION_AUTO=false
# VOCECHAT_GROUP_67890_MENTION_PATTERNS=技术支持,故障,bug,问题
# VOCECHAT_GROUP_67890_MENTION_PATTERNS_MODE=replace


# ------------------------------------------------------------
# 调试配置
# ------------------------------------------------------------

# 如需调试触发器行为，可以临时启用所有日志
# 然后查看日志：journalctl --user -u openclaw-gateway.service -f
#
# 关键日志标识：
# - [vocechat] group trigger evaluated
# - [vocechat] skip group event: no reply trigger
# - [vocechat] group trigger reason=...
